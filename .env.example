# Database (a pooled URL is fine for the app; run migrations against a direct URL)
DATABASE_URL=

# Clash of Clans API
COC_API_TOKEN=
COC_CLAN_TAG=
# Optional. Default is the proxy below; whitelist 45.79.218.79 on your developer key when using it.
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Scheduled sync: the cron service sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# Access lock. Fails closed: visitors are read-only and only a signed-in Leader or Co-Leader
# can edit, unless ACCESS_LOCK is exactly "off". Missing, empty or any other value = locked.
# For local development without signing in, set ACCESS_LOCK=off. Never use "off" in production.
ACCESS_LOCK=
# Required for sign-in: 32+ characters (openssl rand -hex 32). Without it nobody can sign in,
# so with the lock on the app is read-only for everyone.
SESSION_SECRET=
